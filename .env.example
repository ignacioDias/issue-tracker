# Copy to .env and fill in. .env is gitignored.

# --- HTTP server ---
# Port the server listens on (default 8080).
PORT=8080
# Public base URL including scheme, without port or path (e.g. http://localhost).
# Used to build the Google callback URL when GOOGLE_OAUTH_REDIRECT_URL is unset.
HOST=http://localhost

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Full callback URL; overrides HOST + PORT + callback path.
# Must be registered in the Google Cloud console.
GOOGLE_OAUTH_REDIRECT_URL=

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=issues
POSTGRES_PASSWORD=
POSTGRES_DB=issues

# --- Connection strings (set automatically by docker-compose.yml) ---
# Not read by the Go code yet.
DATABASE_URL=postgres://issues:CHANGE_ME@localhost:5432/issues?sslmode=disable
REDIS_URL=redis://localhost:6379/0
